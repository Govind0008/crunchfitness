rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Crunch Fitness — complete Firestore rules (the live rules merged with Events).
// Publish in Firebase console → Firestore → Rules, or `firebase deploy --only firestore:rules`.
//
// Roles live in userRoles/{uid}.role: "admin" | "marketing" | "trainer" | "client".
// An account with no role document has no staff rights. Only admins change roles.
// "marketing" manages public content only (blog, offers, team profiles, event content/media,
// Instagram highlights) — never members, phone numbers, payments, check-ins or roles.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() { return get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data; }
    function hasRole() { return signedIn() && exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)); }
    function isAdmin() { return hasRole() && myRole().role == 'admin'; }
    function isMarketing() { return hasRole() && myRole().role == 'marketing'; }
    // Staff who may edit what the public sees
    function isContentStaff() { return isAdmin() || isMarketing(); }
    // Multi-gym: a staff account belongs to one gym (userRoles.gymId). Accounts created before
    // gyms existed belong to the first gym, Crunch Fitness Wakad.
    function myGym() { return myRole().get('gymId', 'crunch-wakad'); }
    function isGymAdmin(gymId) { return isAdmin() && myGym() == gymId; }
    function isTrainer() { return hasRole() && myRole().role == 'trainer'; }
    function isTrainerOf(trainerId) { return isTrainer() && myRole().trainerId == trainerId; }
    function isClientOf(trainerId) { return hasRole() && myRole().role == 'client' && myRole().trainerId == trainerId; }
    function eventAt(eventId) { return get(/databases/$(database)/documents/events/$(eventId)).data; }
    function eventAfter(eventId) { return getAfter(/databases/$(database)/documents/events/$(eventId)).data; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // True while an admin deletes an event: its records may only be removed together with it
    function eventGone(eventId) { return !existsAfter(/databases/$(database)/documents/events/$(eventId)); }

    // ── Public site content: anyone reads, admins and marketing edit ─────────
    // Drafts stay private until published
    match /posts/{doc} {
      allow read: if resource.data.published == true || isContentStaff();
      allow write: if isContentStaff();
    }
    // Team profiles: marketing edits the public profile; removing a trainer (which also removes
    // their login, roster and classes) stays with admins.
    match /teamMembers/{doc} {
      allow read: if true;
      allow create, update: if isContentStaff();
      allow delete: if isAdmin();
    }
    // Offers are promotional banners only — they never change a plan's price or a payment
    match /offers/{doc} {
      allow read: if true;
      allow write: if isContentStaff();
    }
    // Plan prices are business data: admins only
    match /plans/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries hold customers' phone numbers: anyone can submit, only admins read/manage
    match /enquiries/{doc} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Duty roster — trainers read theirs, admins manage
    match /duties/{doc} {
      allow read: if isAdmin() || isTrainer();
      allow write: if isAdmin();
    }

    // Class sessions — public read (needed for /checkin PIN lookup), admins manage.
    // The public may only move the check-in counter up by one, within capacity (see attendance).
    match /classSessions/{sessionId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if changed().hasOnly(['checkedInCount'])
        && request.resource.data.checkedInCount == resource.data.get('checkedInCount', 0) + 1
        && request.resource.data.checkedInCount <= resource.data.capacity;
    }

    // Attendance — members self check-in at /checkin: one document per person per class
    // ({sessionId}_{phoneKey}, never overwritten), counted on the session in the same write.
    // Phone numbers are visible to staff only.
    match /attendance/{attId} {
      allow create: if attId == request.resource.data.sessionId + '_' + request.resource.data.memberPhoneKey
        && request.resource.data.keys().hasOnly(['sessionId', 'memberName', 'memberPhone', 'memberPhoneKey', 'checkedInAt'])
        && request.resource.data.memberPhoneKey.matches('[0-9]{10}')
        && request.resource.data.memberName is string && request.resource.data.memberName.size() > 0 && request.resource.data.memberName.size() <= 80
        && request.resource.data.checkedInAt == request.time
        && exists(/databases/$(database)/documents/classSessions/$(request.resource.data.sessionId))
        && getAfter(/databases/$(database)/documents/classSessions/$(request.resource.data.sessionId)).data.get('checkedInCount', 0)
           == get(/databases/$(database)/documents/classSessions/$(request.resource.data.sessionId)).data.get('checkedInCount', 0) + 1;
      allow read: if isAdmin() || isTrainer();
      allow update, delete: if isAdmin();
    }

    // Manual check-ins by the front desk (no class): one per member per day, id {date}_{memberId}.
    // Stamped with the server time and the admin's uid; never edited. Admins may delete a mistake.
    match /checkins/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && id == request.resource.data.date + '_' + request.resource.data.memberId
        && request.resource.data.keys().hasOnly(['memberId', 'memberName', 'memberPhoneKey', 'date', 'method', 'by', 'at'])
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.method == 'manual'
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.memberName is string && request.resource.data.memberName.size() > 0 && request.resource.data.memberName.size() <= 120
        && exists(/databases/$(database)/documents/members/$(request.resource.data.memberId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Members — the gym's membership list ──────────────────────────────────
    // Admins manage; a trainer can see the members assigned to them.
    match /members/{memberId} {
      allow read: if isAdmin() || (isTrainer() && resource.data.trainerId == myRole().trainerId);
      allow create, update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 1
        && request.resource.data.phoneKey is string && request.resource.data.phoneKey.matches('[0-9]{10}')
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.activeUntil is string
        // Staff block for door access (always wins over the membership)
        && request.resource.data.get('accessOverride', null) in [null, 'blocked', 'suspended']
        // Photo metadata only — the image itself is private in Storage at members/{id}/photo
        && (request.resource.data.get('photo', null) == null
          || (request.resource.data.photo.path == 'members/' + memberId + '/photo'
            && request.resource.data.photo.contentType.matches('image/.*')
            && request.resource.data.photo.size is int && request.resource.data.photo.size < 8388608));
      allow delete: if isAdmin();
    }

    // Gym-wide admin activity log: append-only
    match /activity/{entryId} {
      allow read: if isAdmin();
      allow create: if isContentStaff() && request.resource.data.at == request.time && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Payments — money actually received ────────────────────────────────────
    // Admins only. Each payment takes the next receipt number (counter moves by exactly one in
    // the same transaction), is never edited, and can only be voided — with a reason. No deletes.
    // What a payment is for (absent on payments recorded before types existed)
    function validPaymentType() {
      return !('paymentType' in request.resource.data) || request.resource.data.paymentType in ['membership', 'pt', 'other'];
    }
    match /payments/{paymentId} {
      allow read: if isAdmin();
      // Imported history (the old member sheet): no receipt number is issued and the counter
      // isn't touched; the id is the row's migration key, so the same row can't be imported twice.
      allow create: if isAdmin()
        && request.resource.data.source == 'legacy_excel'
        && paymentId.matches('lx_[A-Za-z0-9_-]+_p')
        && request.resource.data.receiptNo == null && request.resource.data.receiptSeq == null
        && request.resource.data.amountPaise is int && request.resource.data.amountPaise > 0
        && request.resource.data.countedPaise == request.resource.data.amountPaise
        && request.resource.data.status == 'paid'
        && request.resource.data.method in ['cash', 'upi', 'card', 'bank_transfer', 'other', 'unknown']
        && request.resource.data.paidOn is string && request.resource.data.paidOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.memberId is string
        && request.resource.data.paymentType in ['membership', 'pt', 'other']
        && request.resource.data.createdAt == request.time;
      allow create: if isAdmin()
        && request.resource.data.get('source', 'admin') == 'admin'
        && (request.resource.data.get('category', null) == null || request.resource.data.category is string)
        && validPaymentType()
        && request.resource.data.amountPaise is int && request.resource.data.amountPaise > 0
        && request.resource.data.countedPaise == request.resource.data.amountPaise
        && request.resource.data.status == 'paid'
        && request.resource.data.method in ['cash', 'upi', 'card', 'bank_transfer', 'other']
        && request.resource.data.paidOn is string && request.resource.data.paidOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.memberId is string
        // Optional discount snapshot: whole paise, never negative
        && (!('discountPaise' in request.resource.data) || (request.resource.data.discountPaise is int && request.resource.data.discountPaise >= 0))
        && (!('listPricePaise' in request.resource.data) || request.resource.data.listPricePaise == null || (request.resource.data.listPricePaise is int && request.resource.data.listPricePaise >= 0))
        && request.resource.data.receiptSeq == getAfter(/databases/$(database)/documents/counters/receipts).data.next
        // …and the counter moved in this same write (so a number can never be reused)
        && ((!exists(/databases/$(database)/documents/counters/receipts) && request.resource.data.receiptSeq == 1)
          || (exists(/databases/$(database)/documents/counters/receipts)
            && request.resource.data.receiptSeq == get(/databases/$(database)/documents/counters/receipts).data.next + 1))
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'paid'
        && changed().hasOnly(['status', 'countedPaise', 'voidReason', 'voidedBy', 'voidedAt'])
        && request.resource.data.status == 'void'
        && request.resource.data.countedPaise == 0
        && request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 2;
      allow delete: if false;
    }

    // ── Membership periods and PT packages (history; never deleted) ───────────
    // Admins only; a trainer can read the PT packages assigned to them. PT is its own record —
    // it never changes the gym membership.
    match /memberships/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.memberId is string
        && ((request.resource.data.startDate is string && request.resource.data.endDate is string)
          // Imported history keeps the sheet's blanks (a day pass with no dates) — never invented
          || (request.resource.data.source == 'legacy_excel'
            && (request.resource.data.startDate == null || request.resource.data.startDate is string)
            && (request.resource.data.endDate == null || request.resource.data.endDate is string)))
        && request.resource.data.source in ['payment', 'legacy_excel']
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && !changed().hasAny(['memberId', 'source', 'legacy', 'createdAt', 'paymentId']);
      allow delete: if false;
    }
    match /ptPackages/{id} {
      allow read: if isAdmin() || (isTrainer() && resource.data.trainerId == myRole().trainerId);
      allow create: if isAdmin()
        && request.resource.data.memberId is string
        && request.resource.data.packageName is string && request.resource.data.packageName.size() > 0
        && request.resource.data.source in ['payment', 'legacy_excel']
        && (request.resource.data.sessionsIncluded == null || (request.resource.data.sessionsIncluded is int && request.resource.data.sessionsIncluded > 0))
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && !changed().hasAny(['memberId', 'source', 'legacy', 'createdAt'])
        // A package's first payment is linked once; after that the link never changes
        && (!changed().hasAny(['paymentId']) || resource.data.get('paymentId', null) == null)
        // Sessions used only count up, and never beyond the package
        && (!changed().hasAny(['sessionsUsed']) || (request.resource.data.sessionsUsed is int
          && request.resource.data.sessionsUsed >= resource.data.get('sessionsUsed', 0)
          && (resource.data.sessionsIncluded == null || request.resource.data.sessionsUsed <= resource.data.sessionsIncluded)));
      allow delete: if false;
    }

    // ── Access control (biometric doors) ──────────────────────────────────────
    // Staff register devices and link members to device user IDs. Online status, sync results
    // and scans come only from the integration service (server side, Admin SDK) — the browser
    // can never mark anything "online", "synced" or write a scan.
    match /gyms/{gymId} {
      allow read: if isGymAdmin(gymId);
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if isGymAdmin(gymId);
        allow create: if isGymAdmin(gymId)
          && request.resource.data.gymId == gymId
          && request.resource.data.name is string && request.resource.data.name.size() > 1
          && request.resource.data.protocol in ['adms', 'sdk', 'other']
          && request.resource.data.enabled == true
          && request.resource.data.nextUserId == 1
          && request.resource.data.lastSeenAt == null && request.resource.data.lastSyncAt == null
          && request.resource.data.firmware == null && request.resource.data.lastError == null;
        allow update: if isGymAdmin(gymId)
          && !changed().hasAny(['gymId', 'lastSeenAt', 'lastSyncAt', 'firmware', 'lastError', 'createdAt', 'createdBy'])
          && request.resource.data.protocol in ['adms', 'sdk', 'other']
          && request.resource.data.enabled is bool
          && request.resource.data.nextUserId is int && request.resource.data.nextUserId >= resource.data.nextUserId;
        allow delete: if false;

        // The device's own user list (IDs and names, never fingerprints), reported by the
        // device through the relay so staff can match device users to members
        match /deviceUsers/{deviceUserId} {
          allow read: if isGymAdmin(gymId);
          allow write: if false;
        }

        // Requests to the device (create a user, start fingerprint enrolment, send the user list).
        // Staff only choose the request; the relay builds the device command itself and records
        // the result. Nothing here can delete or change anyone already on the device.
        match /commands/{commandId} {
          allow read: if isGymAdmin(gymId);
          allow create: if isGymAdmin(gymId)
            && request.resource.data.keys().hasOnly(['type', 'deviceUserId', 'name', 'status', 'createdBy', 'createdAt'])
            && request.resource.data.type in ['query_users', 'add_user', 'enroll_fp']
            && request.resource.data.status == 'queued'
            && request.resource.data.createdBy == request.auth.token.email
            && request.resource.data.createdAt == request.time
            && (request.resource.data.type == 'query_users'
              || (request.resource.data.deviceUserId is string && request.resource.data.deviceUserId.matches('[0-9]{1,9}')))
            && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 40));
          allow update, delete: if false;
        }
      }
    }

    // One document per device user: id = {deviceId}_{deviceUserId}, so an ID can't be given twice
    match /biometricIdentities/{identityId} {
      // Checking whether an ID is free reads a document that may not exist yet
      allow get: if isAdmin() && (resource == null || isGymAdmin(resource.data.gymId));
      allow list: if isGymAdmin(resource.data.gymId);
      allow create: if isGymAdmin(request.resource.data.gymId)
        && identityId == request.resource.data.deviceId + '_' + request.resource.data.deviceUserId
        && request.resource.data.deviceUserId.matches('[A-Za-z0-9_-]{1,24}')
        && exists(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)/devices/$(request.resource.data.deviceId))
        // Linked explicitly to one person: a member (gym attendance) or a trainer (staff attendance)
        && ((request.resource.data.get('personType', 'member') == 'member' && request.resource.data.memberId is string)
          || (request.resource.data.personType == 'trainer' && request.resource.data.memberId == null
            && request.resource.data.trainerId is string
            && exists(/databases/$(database)/documents/teamMembers/$(request.resource.data.trainerId))))
        && request.resource.data.status == 'PENDING'
        && request.resource.data.lastSyncedAt == null && request.resource.data.lastSyncError == null;
      allow update: if isGymAdmin(resource.data.gymId)
        && changed().hasOnly(['status', 'enrolledAt', 'updatedAt'])
        && request.resource.data.status in ['PENDING', 'ENROLLED', 'DISABLED', 'REMOVED'];
      allow delete: if false;
    }

    // Trainer attendance from device punches: first punch = check-in, last = check-out, per
    // local day. Written by the relay only; an admin may close a day that has only a check-in
    // (manual check-out, recorded with who and why). Marketing and trainers have no access.
    match /trainerAttendance/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && resource.data.status == 'MISSING_CHECKOUT'
        && request.resource.data.checkoutAt == request.resource.data.manualCheckoutAt
        && request.resource.data.manualCheckoutAt > resource.data.firstAt
        && changed().hasOnly(['manualCheckoutAt', 'manualCheckoutBy', 'manualCheckoutReason', 'checkoutAt', 'durationMs', 'status', 'exceptions', 'updatedAt'])
        && request.resource.data.manualCheckoutBy == request.auth.uid
        && request.resource.data.manualCheckoutReason is string && request.resource.data.manualCheckoutReason.size() > 2
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.updatedAt == request.time;
      allow create, delete: if false;
    }

    // Trainer leave, recorded by admins. Separate from attendance: a punch on a leave day is kept.
    function validLeave(d) {
      return d.trainerId is string && exists(/databases/$(database)/documents/teamMembers/$(d.trainerId))
        && d.from is string && d.from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.to is string && d.to.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.from <= d.to
        && d.type in ['casual', 'sick', 'planned', 'unpaid', 'other']
        && d.status in ['approved', 'pending', 'cancelled']
        && d.reason is string && d.reason.size() <= 300 && d.notes is string && d.notes.size() <= 1000;
    }
    match /trainerLeave/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validLeave(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validLeave(request.resource.data) && !changed().hasAny(['trainerId', 'createdBy', 'createdAt']);
      allow delete: if false;
    }

    // Scans reported by devices — written by the integration service only
    match /accessEvents/{eventId} {
      allow read: if isGymAdmin(resource.data.gymId);
      allow write: if false;
    }

    // Import history (counts only): admins, append-only
    match /imports/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Receipt numbering: only ever moves up by one
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.next == 1;
      allow update: if isAdmin() && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // Admin settings (e.g. the "expiring soon" window)
    match /settings/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Trainer portal ────────────────────────────────────────────────────────
    // Trainer: full access to their own data. Client: read their trainer's data and
    // send session requests (ClientDashboard adds to sessionRequests).
    match /trainerData/{trainerId}/{sub}/{docId} {
      allow read: if isAdmin();
      allow read, write: if isTrainerOf(trainerId);
      allow read: if isClientOf(trainerId);
      allow create: if isClientOf(trainerId) && sub == 'sessionRequests';
    }

    // Progress logs: the trainer, or the client the log belongs to
    match /trainerData/{trainerId}/clients/{clientId}/progressLogs/{logId} {
      allow read: if isAdmin();
      allow read, write: if isTrainerOf(trainerId);
      allow read, write: if isClientOf(trainerId) && myRole().clientId == clientId;
    }

    // Conversations: a trainer with their clients; a client with their trainer
    match /conversations/{convId}/messages/{msgId} {
      allow read, write: if hasRole() && (
        (myRole().role == 'trainer' && convId.matches(myRole().trainerId + '_.*'))
        || (myRole().role == 'client' && convId == myRole().trainerId + '_' + myRole().clientId)
      );
    }

    // ── Roles ─────────────────────────────────────────────────────────────────
    // Everyone reads their own. Admins manage all roles. Trainers create, list and
    // remove logins for their own clients only — nobody can give themselves a role.
    match /userRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
        || (isTrainer() && resource.data.role == 'client' && resource.data.trainerId == myRole().trainerId));
      allow create: if isAdmin()
        || (isTrainer() && request.resource.data.role == 'client' && request.resource.data.trainerId == myRole().trainerId);
      // An admin can't demote or remove their own account (so the gym is never locked out by accident)
      allow update: if isAdmin() && (uid != request.auth.uid || request.resource.data.role == 'admin');
      allow delete: if (isAdmin() && uid != request.auth.uid)
        || (isTrainer() && resource.data.role == 'client' && resource.data.trainerId == myRole().trainerId);
    }

    // ── Instagram highlights (staff-picked real posts, shown as official embeds) ──
    match /socialHighlights/{id} {
      allow read: if resource.data.visible == true || isContentStaff();
      allow create, update: if isContentStaff()
        && request.resource.data.url is string
        && request.resource.data.url.matches('https://www\\.instagram\\.com/(p|reel)/[A-Za-z0-9_-]+/?')
        && request.resource.data.visible is bool;
      allow delete: if isContentStaff();
    }

    // ── Events ────────────────────────────────────────────────────────────────
    // The lifecycle an admin may move an event through (plus a few safe steps back).
    function allowedMove(from, to) {
      return from == to
        || [from, to] in [
          ['draft', 'registration_open'],
          ['registration_open', 'registration_closed'],
          ['registration_closed', 'registration_open'],
          ['registration_open', 'check_in'],
          ['registration_closed', 'check_in'],
          ['check_in', 'live'],
          ['live', 'results_pending'],
          ['results_pending', 'live'],
          ['results_pending', 'results_published'],
          ['results_published', 'results_pending'],
          ['results_published', 'archived'],
          ['archived', 'results_published']
        ];
    }
    function validStatus(s) {
      return s in ['draft', 'registration_open', 'registration_closed', 'check_in', 'live', 'results_pending', 'results_published', 'archived'];
    }

    // A member's registrations across all events (member profile) — one collection-group query
    // instead of one per event. Same audience as the per-event rule: admins only.
    match /{path=**}/registrations/{regId} {
      allow read: if isAdmin();
    }

    // Public-facing event fields marketing may edit on any event (never status, dates,
    // registration, capacity or counts — those stay with admins)
    function eventContentOnly() {
      return changed().hasOnly(['title', 'shortDescription', 'description', 'coverImage', 'location', 'eligibility', 'rules', 'updatedAt']);
    }

    match /events/{eventId} {
      allow read: if isContentStaff() || resource.data.status != 'draft';

      // Marketing may create drafts too; only an admin opens registration
      allow create: if isContentStaff()
        && request.resource.data.status == 'draft'
        && request.resource.data.registrationCount == 0
        && request.resource.data.title is string && request.resource.data.title.size() > 0;

      allow update: if (isAdmin()
          && validStatus(request.resource.data.status)
          && allowedMove(resource.data.status, request.resource.data.status)
          // registrationCount only ever moves through registrations, never by hand
          && request.resource.data.registrationCount == resource.data.registrationCount)
        // Marketing: public content on any event, or any detail of a draft that stays a draft
        || (isMarketing() && (eventContentOnly()
          || (resource.data.status == 'draft' && request.resource.data.status == 'draft'
            && request.resource.data.registrationCount == 0 && request.resource.data.checkedInCount == resource.data.checkedInCount)))
        // Public registration: count goes up by exactly one, in the same write as the new registration
        || (changed().hasOnly(['registrationCount'])
          && resource.data.status == 'registration_open'
          && resource.data.registrationEnabled == true
          && request.resource.data.registrationCount == resource.data.registrationCount + 1
          && (resource.data.capacity == null || request.resource.data.registrationCount <= resource.data.capacity)
          && existsAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(string(request.resource.data.registrationCount))));

      // Deleting an event removes everything under it (same batch, or after it's gone — see eventGone)
      allow delete: if isAdmin();

      // Registrations hold contact details: admins only, except the participant's own create.
      match /registrations/{regId} {
        allow read, update: if isAdmin();
        allow create: if regId == string(eventAfter(eventId).registrationCount)
          && eventAt(eventId).status == 'registration_open'
          && eventAt(eventId).registrationCount + 1 == eventAfter(eventId).registrationCount
          && request.resource.data.keys().hasOnly(['name', 'phone', 'phoneKey', 'email', 'categoryId', 'number', 'status', 'showName', 'passId', 'createdAt'])
          && request.resource.data.status == 'registered'
          && request.resource.data.number == eventAfter(eventId).registrationCount
          && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 80
          && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
          && request.resource.data.email is string && request.resource.data.email.size() <= 120
          && request.resource.data.showName is bool
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin() && eventGone(eventId);
      }

      // The participant's pass: no contact details, readable only by its unguessable id.
      match /passes/{passId} {
        allow get: if true;
        allow list: if isAdmin();
        allow create: if existsAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.resource.data.registrationId))
          && getAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.resource.data.registrationId)).data.passId == passId
          && request.resource.data.keys().hasOnly(['registrationId', 'number', 'name', 'categoryId', 'createdAt'])
          && request.resource.data.number == eventAfter(eventId).registrationCount
          && request.resource.data.createdAt == request.time;
        allow update: if isAdmin();
        allow delete: if isAdmin() && eventGone(eventId);
      }

      // Results: public during LIVE only when flagged for the leaderboard; all public once published.
      match /results/{resultId} {
        allow read: if isAdmin()
          || (eventAt(eventId).status == 'live' && resource.data.public == true)
          || eventAt(eventId).status in ['results_published', 'archived'];
        allow write: if isAdmin() && !(eventAt(eventId).status in ['draft', 'archived']);
        allow delete: if isAdmin() && eventGone(eventId);
      }

      // Media: public only when staff have made it visible.
      match /media/{mediaId} {
        allow read: if isContentStaff() || (resource.data.visible == true && eventAt(eventId).status != 'draft');
        allow create, update, delete: if isContentStaff();
      }

      // Activity log: append-only, admins only.
      match /activity/{activityId} {
        allow read: if isAdmin();
        allow create: if isContentStaff() && request.resource.data.at == request.time && request.resource.data.actorUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin() && eventGone(eventId);
      }
    }
  }
}
