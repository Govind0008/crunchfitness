rules_version = '2';

// Crunch Fitness — Firebase Storage rules.
// Member photos are private: only the gym's admins can read or change them. Nothing else in
// Storage is used by the app (site and event media are on Cloudinary), so everything else is closed.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/userRoles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    match /members/{memberId}/photo {
      allow read, delete: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
